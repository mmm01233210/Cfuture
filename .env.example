# Copy to .env and fill in. All secrets live here, never in config.yaml.

# --- LLM (optional but strongly recommended) --------------------------------
# Without a key the system still runs end-to-end in "template mode": it produces
# a coherent, honest Arabic video built from paper metadata + the field knowledge
# base. With a key, Claude performs deep understanding, simplification and
# fact-checking from the abstract for much higher quality.
ANTHROPIC_API_KEY=

# Or use Google Gemini instead: set llm.provider = gemini in config.yaml, then:
GEMINI_API_KEY=

# Optional overrides (otherwise taken from config.yaml)
# LLM_MODEL=claude-sonnet-4-6
# FIELDS=ai,quantum,robotics
# TTS_VOICE=ar-SA-HamedNeural
# LOG_LEVEL=INFO
# FFMPEG_BINARY=/usr/bin/ffmpeg

# --- Animated AI video backgrounds (only when video.background = ai_video) ----
# Pick one provider in config.yaml (video.video_provider) and set its key here.
REPLICATE_API_TOKEN=
FAL_KEY=

# --- TikTok Content Posting API (only needed when publish.mode = tiktok_api) -
# See: https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Optional: IEEE Xplore (metadata / open-access only, when authorised) ----
IEEE_API_KEY=
